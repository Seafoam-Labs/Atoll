@baseUrl = http://localhost:8080

### Health Check (version-neutral)
GET {{baseUrl}}/health
Accept: application/json

### Get Metrics (Prometheus format, version-neutral)
GET {{baseUrl}}/metrics
Accept: text/plain

### Search Packages by Name
GET {{baseUrl}}/v1/search?query=shelly&by=name
Accept: application/json

### Search Packages by Words
GET {{baseUrl}}/v1/search?query=shelly&by=words
Accept: application/json

### Search Packages by Provides
GET {{baseUrl}}/v1/search?query=shelly&by=provides
Accept: application/json

### List Packages (paged, defaults: page 1, 50 per page)
GET {{baseUrl}}/v1/packages
Accept: application/json

### List Packages (page 2, 100 per page)
GET {{baseUrl}}/v1/packages?page=2&limit=100
Accept: application/json

### Seed Package from AUR
POST {{baseUrl}}/v1/packages/shelly/seed
Accept: application/json

### Get Specific Package
GET {{baseUrl}}/v1/packages/shelly
Accept: application/json

### Get Package Versions
GET {{baseUrl}}/v1/packages/shelly/versions
Accept: application/json

### Get Specific Package Version
GET {{baseUrl}}/v1/packages/shelly/versions/bff52a7644df373cf669c818f0d4f4cc6730fe1a4bb776f0dad2785649f5f835
Accept: application/json

### Delete Package
DELETE {{baseUrl}}/v1/packages/shelly
Accept: application/json

### Get Package Security Status (head revision)
GET {{baseUrl}}/v1/packages/shelly/security
Accept: application/json

### Get Package Security Status (specific revision)
GET {{baseUrl}}/v1/packages/shelly/security?revision=bff52a7644df373cf669c818f0d4f4cc6730fe1a4bb776f0dad2785649f5f835
Accept: application/json

### Trigger a Security Re-scan (head revision)
POST {{baseUrl}}/v1/packages/shelly/security/rescan
Accept: application/json

### Trigger a Security Re-scan (specific revision)
POST {{baseUrl}}/v1/packages/shelly/security/rescan?revision=bff52a7644df373cf669c818f0d4f4cc6730fe1a4bb776f0dad2785649f5f835
Accept: application/json

### AUR RPC v5 (version-neutral, built for yay/paru)
GET {{baseUrl}}/rpc?v=5&type=info&arg[]=shelly
Accept: application/json

### Git Smart HTTP - Ref Advertisement (version-neutral)
GET {{baseUrl}}/packages/shelly.git/info/refs?service=git-upload-pack

### Git Smart HTTP - Upload Pack (version-neutral)
# POST {{baseUrl}}/packages/shelly.git/git-upload-pack
# Content-Type: application/x-git-upload-pack-request
