<Project>

    <!--
        Shared analyzer composition for every project in the solution.
        Rule severities are curated in .editorconfig, not here: this file only turns the
        engines on and pins the third-party analyzer packages. Promoted rules are errors
        there, so a finding fails the build; everything else stays a suggestion for triage.
    -->
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>Default</AnalysisMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.270" PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
        <PackageReference Include="IDisposableAnalyzers" Version="4.0.8" PrivateAssets="all" />
    </ItemGroup>

</Project>
