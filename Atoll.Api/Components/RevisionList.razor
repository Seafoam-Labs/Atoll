@* Revision history rows - stacked-list layout (SHA + badges, message, author/date meta, row actions). *@
<ul class="rev-list" role="list">
    @for (var index = 0; index < Revisions.Count; index++)
    {
        var rev = Revisions[index];
        var previous = index + 1 < Revisions.Count ? Revisions[index + 1] : null;
        <li class="rev-item">
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <a class="font-mono text-sm text-atoll" href="@($"/package/{Name}?rev={rev.Sha}")">
                        @UiFormatting.Truncate(rev.Sha)<span class="sr-only"> - pin the page to this revision</span>
                    </a>
                    @if (rev.IsHead)
                    {
                        <span class="badge badge-seeded">head</span>
                    }
                    <span class="badge @(rev.Status is null ? "" : UiFormatting.BadgeClass(rev.Status.Value))">
                        @(rev.Status?.ToString().ToLowerInvariant() ?? "unscanned")
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(rev.Message))
                {
                    <p class="rev-message">@rev.Message</p>
                }
                <div class="rev-meta">
                    <time datetime="@rev.Date.ToString("yyyy-MM-ddTHH:mm:ssK")">@rev.Date.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</time>
                    <svg viewBox="0 0 2 2" class="size-0.5 fill-current flex-none" aria-hidden="true">
                        <circle r="1" cx="1" cy="1"/>
                    </svg>
                    <span class="truncate">@rev.Author</span>
                </div>
            </div>
            <div class="flex-none flex gap-2">
                <a class="btn" href="@($"/package/{Name}/diff?to={rev.Sha}")">
                    Diff<span class="sr-only">@DiffHint(previous)</span>
                </a>
                <a class="btn" href="@($"/package/{Name}/files?rev={rev.Sha}")">
                    Files<span class="sr-only"> at revision @UiFormatting.Truncate(rev.Sha)</span>
                </a>
                <a class="btn" href="@($"/v1/packages/{Name}/tarball?rev={rev.Sha}")">
                    Snapshot<span class="sr-only"> at revision @UiFormatting.Truncate(rev.Sha)</span>
                </a>
            </div>
        </li>
    }
</ul>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public IReadOnlyList<RevisionRow> Revisions { get; set; } = [];

    /// <summary>Whether <see cref="Revisions" /> is a capped prefix, so its last row may still have an older parent.</summary>
    [Parameter] public bool Truncated { get; set; }

    // The diff link opens the row against the revision stored before it, so the hint names that base rather
    // than repeating the row's own SHA like the Files and Snapshot hints do.
    private string DiffHint(RevisionRow? previous) => previous is not null
        ? $" against the previous revision at {UiFormatting.Truncate(previous.Sha)}"
        : Truncated
            ? " against the revision stored before it"
            : " - the oldest stored revision, so every file reads as added";
}
