@rendermode InteractiveServer
@inject DirectPackageSeeder Seeder
@inject IPackageSecurityRepository SecurityRepository
@inject PackageCatalogService Catalog
@inject NavigationManager Navigation
@inject IOptions<AtollOptions> Atoll
@inject ILogger<PackageActions> Logger

@* Manually driven mutations are disabled on public instances to avoid exposing the
    instance to outbound seeding load and rescan storms; render no buttons at all. *@
@if (Atoll.Value.Mutations.Enabled)
{
    <div class="flex flex-col items-start gap-2">
        @if (!IsSeeded)
        {
            <button type="button" class="btn btn-primary" @onclick="SeedAsync" disabled="@_busy">
                @if (_busy)
                {
                    <span>Seeding…</span>
                }
                else
                {
                    <span>Seed from AUR</span>
                }
            </button>
        }
        else
        {
            <button type="button" class="btn" @onclick="RescanAsync" disabled="@_busy">
                @if (_busy)
                {
                    <span>Queuing…</span>
                }
                else
                {
                    <span>Rescan</span>
                }
            </button>
        }

        @if (_error is not null)
        {
            <div class="text-sec-error text-sm" role="alert">@_error</div>
        }
    </div>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool IsSeeded { get; set; }
    [Parameter] public string? HeadRevisionId { get; set; }

    private bool _busy;
    private string? _error;

    private async Task SeedAsync()
    {
        if (!Atoll.Value.Mutations.Enabled) return;

        _busy = true;
        _error = null;
        try
        {
            await Seeder.SeedAsync(Name);
            Catalog.InvalidateSnapshot();
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (PackageConflictException)
        {
            // Seeded elsewhere while we were looking - refresh to show the seeded state.
            Catalog.InvalidateSnapshot();
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (KeyNotFoundException)
        {
            _error = "This package is no longer known to the AUR index.";
            _busy = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Seeding package {Package} failed", Name);
            _error = "Seeding failed - please try again later.";
            _busy = false;
        }
    }

    private async Task RescanAsync()
    {
        if (!Atoll.Value.Mutations.Enabled || HeadRevisionId is null) return;

        _busy = true;
        _error = null;
        try
        {
            await SecurityRepository.MarkPendingAsync(Name, HeadRevisionId, isHead: true);
            Catalog.InvalidateSnapshot();
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Requesting a rescan of package {Package} failed", Name);
            _error = "Requesting a rescan failed - please try again later.";
            _busy = false;
        }
    }
}
