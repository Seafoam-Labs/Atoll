@rendermode InteractiveServer
@inject IJSRuntime Js
@implements IDisposable

<div class="tabs mt-0 mb-3 gap-6" role="tablist" aria-label="Installation method" @ref="_tabList">
    <button type="button"
            role="tab"
            aria-selected="@(_activeTab == InstallTab.Shelly ? "true" : "false")"
            aria-controls="install-panel-shelly"
            tabindex="@(_activeTab == InstallTab.Shelly ? 0 : -1)"
            id="tab-shelly"
            class="tab py-1.5 @(_activeTab == InstallTab.Shelly ? "active" : "")"
            @onclick="() => SelectTab(InstallTab.Shelly)">
        Shelly
    </button>
    <button type="button"
            role="tab"
            aria-selected="@(_activeTab == InstallTab.Git ? "true" : "false")"
            aria-controls="install-panel-git"
            tabindex="@(_activeTab == InstallTab.Git ? 0 : -1)"
            id="tab-git"
            class="tab py-1.5 @(_activeTab == InstallTab.Git ? "active" : "")"
            @onclick="() => SelectTab(InstallTab.Git)">
        Git clone
    </button>
</div>

<div id="install-panel-shelly"
     role="tabpanel"
     aria-labelledby="tab-shelly"
     hidden="@(_activeTab != InstallTab.Shelly)">
    <div class="flex items-stretch gap-2">
        <div class="cmd flex-1 min-w-0">@ShellyCommand</div>
        <button type="button"
                class="btn shrink-0"
                @onclick="() => CopyAsync(ShellyCommand)">
            @(_copied ? "Copied" : "Copy")
        </button>
    </div>
    <div class="text-ink-faint text-[13px] mt-2">
        This can be permanently set in the shelly
        <a href="https://www.seafoam-labs.org/shelly-alpm/docs/config/" target="_blank"
           rel="noopener" class="underline hover:text-ink"><code>config.json</code></a> file.
    </div>
</div>

<div id="install-panel-git"
     role="tabpanel"
     aria-labelledby="tab-git"
     hidden="@(_activeTab != InstallTab.Git)">
    <div class="flex items-stretch gap-2">
        <div class="cmd flex-1 min-w-0">@GitCommand</div>
        <button type="button"
                class="btn shrink-0"
                @onclick="() => CopyAsync(GitCommand)">
            @(_copied ? "Copied" : "Copy")
        </button>
    </div>
    <div class="text-ink-faint text-[13px] mt-2">
        Served Git SHAs are synthesized by Atoll when it commits stored revisions - they do not match
        upstream AUR. <code>/v1/packages/@Name/versions</code> SHAs are authoritative.
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string ExternalBaseUrl { get; set; } = "";

    private enum InstallTab
    {
        Shelly,
        Git
    }

    private InstallTab _activeTab = InstallTab.Shelly;
    private bool _copied;
    private CancellationTokenSource? _resetCts;
    private ElementReference _tabList;

    private string BaseUrl => ExternalBaseUrl.Trim().TrimEnd('/');
    private string CloneUrl => $"{BaseUrl}/packages/{Name}.git";
    private string ShellyCommand => $"shelly install aur {Name} --aur-url {BaseUrl}";
    private string GitCommand => $"git clone {CloneUrl}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await using var module =
                await Js.InvokeAsync<IJSObjectReference>("import", "./Components/InstallCmdBlock.razor.js");
            await module.InvokeVoidAsync("initTabKeys", _tabList);
        }
        catch (JSDisconnectedException)
        {
            // Tabs work without the module; only arrow-key navigation is lost.
        }
    }

    private void SelectTab(InstallTab tab)
    {
        if (_activeTab == tab) return;
        _activeTab = tab;
        _copied = false;
    }

    // CopyAsync owns _resetCts: it is the only mutator besides Dispose. A tab switch leaves the
    // pending timer alone - its continuation only clears _copied, which the switch already did.
    private async Task CopyAsync(string text)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copied = true;
            StateHasChanged();

            if (_resetCts is { } previous)
            {
                await previous.CancelAsync();
                previous.Dispose();
            }

            var cts = _resetCts = new CancellationTokenSource();
            try
            {
                await Task.Delay(1500, cts.Token);
                _copied = false;
            }
            catch (OperationCanceledException)
            {
                // A newer copy superseded the reset.
            }
            finally
            {
                // An older canceled copy must not clear a newer timer's CTS.
                if (ReferenceEquals(_resetCts, cts)) _resetCts = null;
                cts.Dispose();
            }
        }
        catch (JSException)
        {
            // Clipboard unavailable in an insecure context, or the write was denied for a blurred
            // document. Either way the text stays selectable, so there is nothing to report.
        }
        catch (JSDisconnectedException)
        {
            // Circuit dropped mid-call; there is nobody left to report to.
        }
    }

    public void Dispose()
    {
        _resetCts?.Cancel();
        _resetCts?.Dispose();
    }
}
