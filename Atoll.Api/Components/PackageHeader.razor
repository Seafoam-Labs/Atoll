@* Shared page header for all package tabs: name, version, badges, description, actions. *@
<div class="mb-5 lg:flex lg:items-start lg:justify-between">
    <div class="min-w-0 flex-1">
        <h1 class="mb-1 flex flex-wrap items-baseline gap-3 text-2xl/7 font-bold tracking-tight sm:text-3xl">
            @Meta.Name
            <span class="font-mono text-atoll text-base font-medium">@Meta.Version</span>
        </h1>
        <div class="flex flex-wrap items-center gap-2 text-ink-soft text-sm">
            @if (Details.IsSeeded)
            {
                <span class="badge badge-seeded">seeded</span>
            }
            @if (HeadScan is not null)
            {
                <span class="badge @UiFormatting.BadgeClass(HeadScan.Status)">@HeadScan.Status.ToString().ToLowerInvariant()</span>
            }
            @if (Meta.OutOfDate is not null)
            {
                <span class="badge badge-stale">out-of-date</span>
            }
            @if (!string.IsNullOrEmpty(Meta.Maintainer))
            {
                <span class="text-ink-faint">· maintained by @Meta.Maintainer</span>
            }
            @if (Meta.License.Count > 0)
            {
                <span class="text-ink-faint">· @string.Join(", ", Meta.License)</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Meta.Description))
        {
            <p class="mt-3 text-ink-soft max-w-[60ch]">@Meta.Description</p>
        }
    </div>
    <div class="mt-5 flex gap-2 lg:mt-0 lg:ml-4">
        <PackageActions Name="@Meta.Name" IsSeeded="@Details.IsSeeded" HeadRevisionId="@Details.Head?.HeadRevisionId"/>
        <a class="btn" href="@($"https://aur.archlinux.org/packages/{Meta.Name}")" target="_blank" rel="noopener">AUR ↗</a>
        @if (!string.IsNullOrWhiteSpace(Meta.Url))
        {
            <a class="btn" href="@Meta.Url" target="_blank" rel="noopener">Upstream ↗</a>
        }
    </div>
</div>

@code {
    [Parameter] public PackageDetails Details { get; set; } = null!;

    private AurPackageMetadata Meta => Details.Metadata;
    private PackageSecurityScanDocument? HeadScan => Details.HeadScan;
}
