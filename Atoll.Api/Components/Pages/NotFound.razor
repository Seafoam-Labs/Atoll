@page "/not-found"
@layout MainLayout
@inject IOptions<UiOptions> Ui

<PageTitle>Not found - @Ui.Value.BrandName</PageTitle>

<HeadContent>
    <meta name="description"
          content="@($"Nothing lives at this address on the {Ui.Value.BrandName} AUR mirror.")"/>
</HeadContent>

<h1>Page not found</h1>
<div class="card">
    <p class="mb-0 text-ink-soft">Nothing lives at this address. The package you are looking for may have been
        renamed, removed from the AUR index, or the link is simply wrong.</p>
</div>
<p class="mt-6"><a href="/">← Back to the package catalog</a></p>
