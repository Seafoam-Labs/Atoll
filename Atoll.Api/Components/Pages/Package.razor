@page "/package/{Name}"
@inject PackageDetailsService Details
@inject IOptions<UiOptions> Ui

<PageTitle>@Name — @Ui.Value.BrandName</PageTitle>

@if (!_loaded)
{
    <p class="text-ink-faint">Loading…</p>
}
else if (_details is null)
{
    <NotFound/>
}
else
{
    var meta = _details.Metadata;
    var selectedScan = _details.SelectedScan;
    var revForTabs = _details is { RevisionFellBack: false, SelectedIsHead: false }
        ? _details.SelectedRevisionId
        : null;

    <PackageHeader Details="@_details"/>

    <PackageTabs Name="@Name" RevisionCount="@(_details.Head?.Revisions.Count ?? 0)" Current="overview" Rev="@revForTabs"/>

    @if (_details.RevisionFellBack)
    {
        <div class="status-banner status-banner-pending mb-5">
            <strong>Revision not found</strong>
            <span class="text-ink-soft"> — no revision <code>@Rev</code> exists for this package; showing the head revision instead.</span>
        </div>
    }
    else if (!_details.SelectedIsHead && _details.IsSeeded)
    {
        <div class="mb-5 text-sm text-ink-soft">
            Pinned to revision <code class="text-atoll-light">@UiFormatting.Truncate(_details.SelectedRevisionId)</code>
            (not head) · <a href="@($"/package/{Name}")">back to head</a>
        </div>
    }

    @if (_details.IsSeeded && !_details.Access.Allowed)
    {
        <div class="status-banner @UiFormatting.BannerClass(_details.Access.ReasonCode) mb-5">
            <strong>@UiFormatting.BannerTitle(_details.Access.ReasonCode)</strong>
            <span class="text-ink-soft"> @UiFormatting.BannerBody(_details.Access.ReasonCode)</span>
            <div class="text-ink-faint text-xs mt-1">
                Content and Git access stay blocked until a scan completes with no critical/high findings.
                Request a rescan to re-queue it.
            </div>
        </div>
    }

    @if (_details.IsSeeded && _details.Access.Allowed)
    {
        <div class="mb-5">
            <GitCloneBlock Name="@meta.Name" ExternalBaseUrl="@Ui.Value.ExternalBaseUrl"/>
            <div class="text-ink-faint text-[13px] mt-2">
                Served Git SHAs are synthesized by Atoll when it commits stored revisions — they do not match
                upstream AUR. <code>/packages/@meta.Name/versions</code> SHAs are authoritative.
            </div>
        </div>
    }

    <div class="grid grid-cols-2 gap-5 max-[880px]:grid-cols-1">
        <section class="card">
            <h2 class="mt-0">Metadata</h2>
            <dl class="meta mb-0">
                <div><dt>Package base</dt><dd class="font-mono">@meta.PackageBase</dd></div>
                <div><dt>Maintainer</dt><dd>@(meta.Maintainer ?? "—")</dd></div>
                @if (meta.CoMaintainers.Count > 0)
                {
                    <div><dt>Co-maintainers</dt><dd>@string.Join(", ", meta.CoMaintainers)</dd></div>
                }
                <div><dt>Submitter</dt><dd>@(meta.Submitter ?? "—")</dd></div>
                <div><dt>Votes</dt><dd class="font-mono">@meta.NumVotes</dd></div>
                <div><dt>Popularity</dt><dd class="font-mono">@meta.Popularity.ToString("0.000000")</dd></div>
                <div><dt>First submitted</dt><dd class="font-mono">@UiFormatting.FormatUnix(meta.FirstSubmitted, "yyyy-MM-dd HH:mm")</dd></div>
                <div><dt>Last modified</dt><dd class="font-mono">@UiFormatting.FormatUnix(meta.LastModified, "yyyy-MM-dd HH:mm")</dd></div>
                <div><dt>Out-of-date</dt><dd class="font-mono">@(meta.OutOfDate is null ? "no" : UiFormatting.FormatUnix(meta.OutOfDate.Value, "yyyy-MM-dd HH:mm"))</dd></div>
            </dl>
        </section>

        <section class="card">
            <h2 class="mt-0">Relations</h2>
            <RelationList Title="Depends" Items="meta.Depends"/>
            <RelationList Title="Make dependencies" Items="meta.MakeDepends"/>
            <RelationList Title="Optional dependencies" Items="meta.OptDepends"/>
            <RelationList Title="Conflicts" Items="meta.Conflicts"/>
            <RelationList Title="Provides" Items="meta.Provides"/>
        </section>

        <section class="card col-span-full">
            <h2 class="mt-0">Security</h2>

            @if (!_details.IsSeeded)
            {
                <p class="mb-0 text-ink-soft text-sm">
                    This package is not seeded yet — Atoll stores no content and has no scan state for it.
                    Seeding pulls the files from the AUR and runs the static security scan.
                </p>
            }
            else
            {
                @if (selectedScan is not null)
                {
                    <div class="status-banner @UiFormatting.BannerClass(selectedScan.Status) mb-4">
                        <strong>@selectedScan.Status</strong>
                        <span class="text-ink-soft"> — @UiFormatting.StatusSummary(selectedScan.Status)</span>
                        <div class="text-ink-faint text-xs mt-1 flex flex-wrap gap-x-4 gap-y-1">
                            <span>
                                revision <code>@UiFormatting.Truncate(_details.SelectedRevisionId)</code>@(_details.SelectedIsHead ? "" : " (not head)")
                            </span>
                            <span>scanned @(selectedScan.ScannedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "not yet") UTC</span>
                            <span>findings @UiFormatting.SeverityCountSummary(selectedScan.Findings)</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="status-banner status-banner-pending mb-4">
                        <strong>Pending</strong>
                        <span class="text-ink-soft"> — no scan document for revision
                            <code>@UiFormatting.Truncate(_details.SelectedRevisionId)</code> yet; it will be picked up by the scanner.</span>
                    </div>
                }

                @if (_details.Scans.Count > 0)
                {
                    <h3>Revision scans</h3>
                    <table class="pkg-table">
                        <thead>
                        <tr>
                            <th scope="col">Revision</th>
                            <th scope="col">Status</th>
                            <th scope="col">Scanned</th>
                            <th scope="col">Findings</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var scan in _details.Scans)
                        {
                            <tr>
                                <td class="font-mono">
                                    <a href="@($"/package/{Name}?rev={scan.RevisionId}")">@UiFormatting.Truncate(scan.RevisionId)</a>
                                    @if (scan.IsHead)
                                    {
                                        <span class="badge badge-seeded ml-2">head</span>
                                    }
                                </td>
                                <td><span class="badge @UiFormatting.BadgeClass(scan.Status)">@scan.Status.ToString().ToLowerInvariant()</span></td>
                                <td class="font-mono text-[13px]">@(scan.ScannedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="font-mono">@scan.Findings.Count</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (selectedScan is { Findings.Count: > 0 })
                {
                    <h3>@(_details.SelectedIsHead ? "Head findings" : "Revision findings")</h3>
                    <div class="flex flex-col gap-3">
                        @foreach (var finding in selectedScan.Findings.OrderByDescending(f => f.Severity))
                        {
                            <div class="finding-card @UiFormatting.FindingCardClass(finding.Severity)">
                                <div class="flex flex-wrap items-center gap-2 text-sm">
                                    <span class="badge @UiFormatting.SeverityBadgeClass(finding.Severity)">@finding.Severity.ToString().ToLowerInvariant()</span>
                                    <code class="text-ink">@finding.RuleId</code>
                                    <span class="text-ink-faint">in</span>
                                    <code class="text-ink">@finding.File</code>
                                </div>
                                <p class="text-sm text-ink-soft mt-2 mb-0">@finding.Message</p>
                                @if (!string.IsNullOrWhiteSpace(finding.Snippet))
                                {
                                    <pre class="cmd mt-2 mb-0 text-[13px]">@finding.Snippet</pre>
                                }
                            </div>
                        }
                    </div>
                }

                <p class="text-ink-faint text-[13px] mt-4 mb-0">
                    Findings below High severity are retained for review but do not block serving.
                    Verified means no obvious red flags from static analysis — never a guarantee that a package is safe.
                </p>
            }
        </section>
    </div>

    <p class="mt-6"><a href="/">← Back to the package catalog</a></p>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "rev")]
    private string? Rev { get; set; }

    private PackageDetails? _details;
    private bool _loaded;
    private int _loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var details = await Details.GetAsync(Name, Rev);
        if (version != _loadVersion) return; // a newer navigation superseded this load
        _details = details;
        _loaded = true;

        // Unknown packages render the 404 body with a matching status code; pages render
        // buffered (no stream rendering), so the code can still be set here.
        if (_details is null)
            HttpContext?.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
