@page "/"
@rendermode InteractiveServer
@inject PackageCatalogService Catalog
@inject NavigationManager Nav
@inject PackageIndexUpdater IndexUpdater
@inject IOptions<UiOptions> Ui
@inject ILogger<Index> Logger

<PageTitle>Packages - @Ui.Value.BrandName</PageTitle>

<h1>Packages</h1>

<div class="flex flex-col gap-3 mt-4 mb-2 lg:flex-row lg:flex-wrap lg:items-start">
    <form class="flex min-w-0 gap-2 w-full lg:flex-1 lg:max-w-135"
          @onsubmit="ReloadNow" @onsubmit:preventDefault>
        <div class="grid min-w-0 flex-1 grid-cols-1">
            <input type="search"
                   class="field col-start-1 row-start-1 pl-10"
                   placeholder="Search packages…"
                   aria-label="Search packages"
                   value="@_query"
                   @oninput="OnQueryInput"/>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                 class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-ink-faint">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
        </div>
        <button type="submit" class="btn btn-primary shrink-0">Search</button>
    </form>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:flex lg:flex-1 lg:flex-wrap">
        <select class="field col-span-2 sm:col-span-1 lg:max-w-42.5" @bind="_mode" @bind:after="ReloadNow" aria-label="Search by">
            <option value="@CatalogSearchMode.Name">Name / description</option>
            <option value="@CatalogSearchMode.Words">Words</option>
            <option value="@CatalogSearchMode.Provides">Provides</option>
        </select>

        <select class="field lg:max-w-42.5" @bind="_seededFilter" @bind:after="ReloadNow" aria-label="Seeded filter">
            <option value="@CatalogSeededFilter.All">All packages</option>
            <option value="@CatalogSeededFilter.Seeded">Seeded</option>
            <option value="@CatalogSeededFilter.IndexOnly">Index only</option>
        </select>

        <select class="field lg:max-w-42.5" @bind="_securityFilter" @bind:after="ReloadNow" aria-label="Security filter">
            <option value="@CatalogSecurityFilter.Any">Any security state</option>
            <option value="@CatalogSecurityFilter.Verified">Verified</option>
            <option value="@CatalogSecurityFilter.Flagged">Flagged</option>
            <option value="@CatalogSecurityFilter.Pending">Pending</option>
            <option value="@CatalogSecurityFilter.Error">Error</option>
        </select>
    </div>
</div>

<div class="text-ink-soft text-sm mb-4">
    @if (_loading && _result is null)
    {
        <span>Loading…</span>
    }
    else if (_error is not null)
    {
        <span class="text-sec-error" role="alert">@_error</span>
    }
    else if (_result is not null)
    {
        <span>@_result.TotalMatches package@(_result.TotalMatches == 1 ? "" : "s")</span>
        @if (!string.IsNullOrWhiteSpace(_appliedQuery))
        {
            <span> matching <strong>@_appliedQuery</strong></span>
        }

        var refreshed = IndexUpdater.GetStatus().LastSucceededUtc;
        var loaded = IndexUpdater.GetStatus().LastLoadedFromCacheUtc;
        @if (refreshed is not null)
        {
            <span class="text-ink-faint"> · index refreshed @refreshed.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
        }
        else if (loaded is not null)
        {
            <span class="text-ink-faint"> · index loaded from cache @loaded.Value.ToString("yyyy-MM-dd HH:mm") UTC, refresh pending</span>
        }
        else
        {
            <span class="text-ink-faint"> · index not yet loaded</span>
        }
    }
</div>

@if (_result is not null && _result.TotalMatches == 0)
{
    <div class="card mt-4 text-center">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
             class="mx-auto size-12 text-ink-faint">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
        </svg>
        <h2 class="mt-2 mb-0 text-sm font-semibold text-ink">No packages found</h2>
        <p class="mt-1 mb-0 text-sm text-ink-soft">Try a different search term or clear the filters.</p>
        <div class="mt-6">
            <button type="button" class="btn" @onclick="ClearFilters">Clear filters</button>
        </div>
    </div>
}
else if (_result is not null)
{
    <div class="flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6">
                <table class="pkg-table min-w-full">
                    <thead>
                    <tr>
                        <th scope="col" class="w-40 sm:w-64">
                            <button class="sort" @onclick="@(() => ToggleSort(CatalogSort.NameAsc, CatalogSort.NameDesc))">
                                Name
                                @if (_sort == CatalogSort.NameAsc)
                                {
                                    <span class="arrow">▼</span>
                                }
                                else if (_sort == CatalogSort.NameDesc)
                                {
                                    <span class="arrow">▲</span>
                                }
                            </button>
                        </th>
                        <th scope="col" class="hidden whitespace-nowrap md:table-cell">Version</th>
                        <th scope="col">Description</th>
                        <th scope="col" class="hidden sm:table-cell">
                            <button class="sort" @onclick="@(() => ToggleSort(CatalogSort.VotesDesc, CatalogSort.VotesAsc))">
                                Votes
                                @if (_sort == CatalogSort.VotesDesc)
                                {
                                    <span class="arrow">▼</span>
                                }
                                else if (_sort == CatalogSort.VotesAsc)
                                {
                                    <span class="arrow">▲</span>
                                }
                            </button>
                        </th>
                        <th scope="col" class="hidden lg:table-cell">
                            <button class="sort" @onclick="@(() => ToggleSort(CatalogSort.PopularityDesc, CatalogSort.PopularityAsc))">
                                Popularity
                                @if (_sort == CatalogSort.PopularityDesc)
                                {
                                    <span class="arrow">▼</span>
                                }
                                else if (_sort == CatalogSort.PopularityAsc)
                                {
                                    <span class="arrow">▲</span>
                                }
                            </button>
                        </th>
                        <th scope="col" class="hidden md:table-cell">
                            <button class="sort" @onclick="@(() => ToggleSort(CatalogSort.LastModifiedDesc, CatalogSort.LastModifiedAsc))">
                                Last modified
                                @if (_sort == CatalogSort.LastModifiedDesc)
                                {
                                    <span class="arrow">▼</span>
                                }
                                else if (_sort == CatalogSort.LastModifiedAsc)
                                {
                                    <span class="arrow">▲</span>
                                }
                            </button>
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in _result.Rows)
                    {
                        var package = row.Package;
                        <tr>
                            <td class="w-40 sm:w-64">
                                <div class="flex flex-col gap-1 max-w-[10rem] sm:max-w-[16rem]">
                                    <a href="@($"/package/{package.Name}")" class="truncate font-semibold text-ink" title="@package.Name">@package.Name</a>
                                    @if (!string.Equals(package.PackageBase, package.Name, StringComparison.Ordinal))
                                    {
                                        <div class="text-ink-faint text-[13px] truncate -mt-1" title="base: @package.PackageBase">base: @package.PackageBase</div>
                                    }
                                    @if (row.IsSeeded || row.Head is not null)
                                    {
                                        <div class="flex flex-wrap gap-1 -ml-1">
                                            @if (row.IsSeeded)
                                            {
                                                <span class="badge badge-seeded">seeded</span>
                                            }
                                            @if (row.Head is not null)
                                            {
                                                <span class="badge @UiFormatting.BadgeClass(row.Head.Status)">@row.Head.Status.ToString().ToLowerInvariant()</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="hidden whitespace-nowrap font-mono md:table-cell">@package.Version</td>
                            <td>@package.Description</td>
                            <td class="hidden whitespace-nowrap font-mono sm:table-cell">@package.NumVotes</td>
                            <td class="hidden whitespace-nowrap font-mono lg:table-cell">@package.Popularity.ToString("0.000000")</td>
                            <td class="hidden whitespace-nowrap font-mono text-[13px] md:table-cell">@UiFormatting.FormatUnix(package.LastModified)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <nav class="mt-3 flex items-center justify-between gap-3 text-sm text-ink-soft" aria-label="Pagination">
        @{
            var first = (_result.Page - 1) * _result.PageSize + 1;
            var last = Math.Min(_result.Page * _result.PageSize, _result.TotalMatches);
        }
        <span>Page @_result.Page of @_result.TotalPages · showing @first-@last of @_result.TotalMatches</span>
        <div class="flex items-center gap-2">
            <button type="button" class="btn" disabled="@(_result.Page <= 1)"
                    @onclick="@(() => GoToPage(_result.Page - 1))">‹ Prev</button>
            <div class="hidden items-center gap-1 sm:flex">
                @foreach (var p in PageWindow())
                {
                    if (p is null)
                    {
                        <span class="px-1" aria-hidden="true">…</span>
                    }
                    else
                    {
                        <button type="button" class="page-btn" aria-current="@(p == _result.Page ? "page" : null)"
                                @onclick="@(() => GoToPage(p.Value))">@p</button>
                    }
                }
            </div>
            <button type="button" class="btn" disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="@(() => GoToPage(_result.Page + 1))">Next ›</button>
        </div>
    </nav>
}

@code {
    private string _query = "";
    private string _appliedQuery = "";
    private CatalogSearchMode _mode = CatalogSearchMode.Name;
    private CatalogSeededFilter _seededFilter = CatalogSeededFilter.All;
    private CatalogSecurityFilter _securityFilter = CatalogSecurityFilter.Any;
    private CatalogSort _sort = CatalogSort.NameAsc;
    private CatalogResult? _result;
    private bool _loading;
    private string? _error;
    private int _searchVersion;
    private bool _parametersInitialized;
    // URIs of navigations this component initiated but hasn't seen resolved yet.
    private readonly HashSet<string> _pendingSelfNavigations = new(StringComparer.Ordinal);

    private int _page = 1;

    [SupplyParameterFromQuery(Name = "q")] private string? QueryParam { get; set; }

    [SupplyParameterFromQuery(Name = "page")] private int? PageParam { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Navigations we initiated ourselves come back through here. The input
        // already holds the target query/page (or newer text, if the user kept
        // typing while the navigation was in flight), so skip the sync instead of
        // clobbering it.
        if (_pendingSelfNavigations.Remove(Nav.Uri))
        {
            return;
        }

        var query = QueryParam ?? "";
        var page = Math.Max(1, PageParam ?? 1);
        var stateChanged = !_parametersInitialized ||
                           !string.Equals(_query, query, StringComparison.Ordinal) ||
                           _page != page;
        _parametersInitialized = true;

        if (stateChanged)
        {
            _query = query;
            _page = page;
            await ReloadAsync();
        }
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
    }

    private void ToggleSort(CatalogSort primary, CatalogSort secondary)
    {
        _sort = _sort == primary ? secondary : primary;
        ReloadNow();
    }

    private void ClearFilters()
    {
        _query = _appliedQuery = "";
        _mode = CatalogSearchMode.Name;
        _seededFilter = CatalogSeededFilter.All;
        _securityFilter = CatalogSecurityFilter.Any;
        _sort = CatalogSort.NameAsc;
        ReloadNow();
    }

    private void ReloadNow()
    {
        // A fresh query, filter or sort change always restarts from the first page.
        _page = 1;
        _ = ReloadAsync();
    }

    private void GoToPage(int page)
    {
        _page = page;
        _ = ReloadAsync();
    }

    /// First page, last page, and the pages adjacent to the current one, with nulls marking ellipsis gaps.
    private IEnumerable<int?> PageWindow()
    {
        var total = _result!.TotalPages;
        var pages = new SortedSet<int> { 1, total };
        for (var p = _result.Page - 1; p <= _result.Page + 1; p++)
        {
            if (p >= 1 && p <= total) pages.Add(p);
        }

        int? previous = null;
        foreach (var p in pages)
        {
            if (previous is not null && p - previous > 1) yield return null;
            yield return p;
            previous = p;
        }
    }

    private async Task ReloadAsync()
    {
        var version = Interlocked.Increment(ref _searchVersion);
        _loading = true;
        _appliedQuery = _query;

        var q = string.IsNullOrWhiteSpace(_query) ? null : _query;
        var parameters = new Dictionary<string, object?> { ["q"] = q };
        if (_page > 1) parameters["page"] = _page;
        var uri = Nav.GetUriWithQueryParameters(parameters);
        if (uri != Nav.Uri)
        {
            _pendingSelfNavigations.Add(uri);
            Nav.NavigateTo(uri, forceLoad: false);
        }

        try
        {
            var result = await Catalog.SearchAsync(_query, _seededFilter, _securityFilter, _mode, _sort, _page);
            if (version != _searchVersion) return;

            // A navigation may have demanded a page beyond the last one; drop back to the final page.
            if (_page > result.TotalPages)
            {
                _page = result.TotalPages;
                result = await Catalog.SearchAsync(_query, _seededFilter, _securityFilter, _mode, _sort, _page);
                if (version != _searchVersion) return;
            }

            _result = result;
            _error = null;
        }
        catch (Exception ex)
        {
            if (version != _searchVersion) return;
            _error = "The search failed - the package index may be temporarily unavailable.";
            Logger.LogError(ex, "Catalog search failed");
        }
        finally
        {
            if (version == _searchVersion)
                _loading = false;
        }
    }

}
