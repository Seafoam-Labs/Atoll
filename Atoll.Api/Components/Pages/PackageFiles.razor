@page "/package/{Name}/files"
@inject PackageDetailsService Details
@inject IOptions<UiOptions> Ui

<PageTitle>Files — @Name — @Ui.Value.BrandName</PageTitle>

@if (!_loaded)
{
    <p class="text-ink-faint">Loading…</p>
}
else if (_details is null || _files is null)
{
    <NotFound/>
}
else
{
    var revForTabs = _files is { RevisionFellBack: false, IsHead: false } ? _files.RevisionId : null;

    <PackageHeader Details="@_details"/>

    <PackageTabs Name="@Name" RevisionCount="@(_details.Head?.Revisions.Count ?? 0)" Current="files" Rev="@revForTabs"/>

    @if (_files.RevisionFellBack)
    {
        <div class="status-banner status-banner-pending mb-5">
            <strong>Revision not found</strong>
            <span class="text-ink-soft"> — no revision <code>@Rev</code> exists for this package; showing the head revision instead.</span>
        </div>
    }

    @if (!_details.IsSeeded)
    {
        <div class="card text-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                 class="mx-auto size-12 text-ink-faint">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
            </svg>
            <h2 class="mt-2 mb-0 text-sm font-semibold text-ink">No files stored</h2>
            <p class="mt-1 mb-0 text-sm text-ink-soft">
                This package is not seeded — Atoll stores no sources for it. Seed it from the
                overview page to pull the files from the AUR.
            </p>
            <div class="mt-6">
                <a class="btn" href="@($"/package/{Name}")">Go to overview</a>
            </div>
        </div>
    }
    else if (!_files.Access.Allowed)
    {
        <BlockedRevisionBanner Access="@_files.Access"/>
    }
    else
    {
        <div class="mb-4 text-sm text-ink-soft flex flex-wrap items-center gap-x-2">
            <span>revision</span>
            <code class="text-atoll-light">@UiFormatting.Truncate(_files.RevisionId)</code>
            <span class="text-ink-faint">@(_files.IsHead ? "(head)" : "(not head)")</span>
            <span>·</span>
            <span>@_files.TotalEntries file@(_files.TotalEntries == 1 ? "" : "s")</span>
        </div>

        @if (_files.Entries.Count == 0)
        {
            <div class="card text-center">
                <h2 class="mt-0 mb-0 text-sm font-semibold text-ink">No files at this revision</h2>
                <p class="mt-1 mb-0 text-sm text-ink-soft">The stored revision document contains no files.</p>
            </div>
        }
        else
        {
            <div class="grid gap-5 items-start lg:grid-cols-[minmax(220px,280px)_minmax(0,1fr)]">
                <div class="min-w-0">
                    <FileBrowser Name="@Name" RevisionId="@_files.RevisionId" Entries="@_files.Entries" SelectedPath="@_files.SelectedPath"/>
                    @if (_files.EntriesTruncated)
                    {
                        <div class="mt-2 text-[13px] text-ink-faint">
                            Showing the first @PackageDetailsService.TreeRenderCap of @_files.TotalEntries entries.
                        </div>
                    }
                </div>
                <div class="min-w-0">
                    @if (_files.FileNotFound)
                    {
                        <div class="status-banner status-banner-pending">
                            <strong>File not found</strong>
                            <span class="text-ink-soft"> — <code>@_files.SelectedPath</code> is not part of this revision. Pick a file from the tree.</span>
                        </div>
                    }
                    else if (_files.SelectedPath is null)
                    {
                        <div class="card text-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                                 class="mx-auto size-12 text-ink-faint">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                            </svg>
                            <h2 class="mt-2 mb-0 text-sm font-semibold text-ink">Pick a file to preview it</h2>
                            <p class="mt-1 mb-0 text-sm text-ink-soft">
                                Choose a file from the tree — the selection is kept in the URL, so views are shareable.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                            <h2 class="mt-0 mb-0 font-mono text-sm text-ink wrap-anywhere">@_files.SelectedPath</h2>
                            <span class="text-xs text-ink-faint font-mono">@UiFormatting.FormatBytes(_files.ContentBytes)</span>
                        </div>
                        <FileViewer Content="@_files.Content"
                                    ContentBytes="@_files.ContentBytes"
                                    IsBinary="@_files.IsBinary"
                                    IsTruncated="@_files.IsTruncated"/>
                    }
                </div>
            </div>
        }
    }

    <p class="mt-6"><a href="/">← Back to the package catalog</a></p>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "rev")]
    private string? Rev { get; set; }

    [SupplyParameterFromQuery(Name = "path")]
    private string? Path { get; set; }

    private PackageDetails? _details;
    private PackageFilesView? _files;
    private bool _loaded;
    private int _loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var details = await Details.GetAsync(Name);
        var files = await Details.GetFilesAsync(Name, Rev, Path);
        if (version != _loadVersion) return; // a newer navigation superseded this load
        _details = details;
        _files = files;
        _loaded = true;

        if (_details is null)
            HttpContext?.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
