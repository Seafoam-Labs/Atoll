@rendermode InteractiveServer
@inject IJSRuntime Js
@implements IDisposable

<div class="flex items-stretch gap-2">
    <div class="cmd flex-1 min-w-0">git clone @CloneUrl</div>
    <button type="button" class="btn shrink-0" @onclick="CopyAsync">@(_copied ? "Copied" : "Copy")</button>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string ExternalBaseUrl { get; set; } = "";

    private bool _copied;
    private CancellationTokenSource? _resetCts;

    private string CloneUrl => $"{ExternalBaseUrl.TrimEnd('/')}/packages/{Name}.git";

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"git clone {CloneUrl}");
            _copied = true;
            StateHasChanged();

            var previous = _resetCts;
            if (previous is not null)
            {
                await previous.CancelAsync();
                previous.Dispose();
            }
            _resetCts = new CancellationTokenSource();
            var token = _resetCts.Token;

            try
            {
                await Task.Delay(1500, token);
                _copied = false;
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                // A newer copy superseded the reset.
            }
        }
        catch (JSException)
        {
            // Clipboard API unavailable (non-secure context); the text stays selectable.
        }
    }

    public void Dispose()
    {
        _resetCts?.Cancel();
        _resetCts?.Dispose();
    }
}
