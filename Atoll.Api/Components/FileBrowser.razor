@* File picker for one revision. Entries arrive pre-sorted (directories first); the tree build
   below preserves that order, and selection round-trips through the URL (?path=) so the
   pages can stay static SSR - every node is a plain link, no interactivity required. *@
<ul class="file-tree" role="list">
    @foreach (var (node, depth) in _flat)
    {
        @if (node.IsDir)
        {
            <li class="file-tree-dir" style="--depth:@depth">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                     class="size-4 flex-none">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"/>
                </svg>
                <span class="truncate font-mono">@node.Name</span>
            </li>
        }
        else
        {
            var selected = node.Path == SelectedPath;
            <li>
                <a class="file-tree-file @(selected ? "selected" : "")" style="--depth:@depth"
                   href="@Href(node.Path)"
                   aria-current="@(selected ? "page" : null)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                         class="size-4 flex-none">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                    </svg>
                    <span class="truncate font-mono">@node.Name</span>
                    <span class="ml-auto pl-2 flex-none font-mono text-xs text-ink-faint">@UiFormatting.FormatBytes(node.Size)</span>
                </a>
            </li>
        }
    }
</ul>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string RevisionId { get; set; } = "";
    [Parameter] public IReadOnlyList<PackageFileEntry> Entries { get; set; } = [];
    [Parameter] public string? SelectedPath { get; set; }

    private IReadOnlyList<(TreeNode Node, int Depth)> _flat = [];

    protected override void OnParametersSet()
    {
        var root = new TreeNode();
        foreach (var entry in Entries)
        {
            var segments = entry.Path.Split('/');
            var current = root;
            var directoryPath = "";
            for (var i = 0; i < segments.Length - 1; i++)
            {
                directoryPath = directoryPath.Length == 0 ? segments[i] : directoryPath + "/" + segments[i];
                current = current.GetOrAddDirectory(segments[i], directoryPath);
            }

            current.Files.Add(new TreeNode(segments[^1], entry.Path, false, entry.Size));
        }

        var flat = new List<(TreeNode Node, int Depth)>(Entries.Count);
        Flatten(root, 0, flat);
        _flat = flat;
    }

    private string Href(string path)
    {
        // rev is always explicit here so a link keeps pointing at the same tree even after a refresh.
        return $"/package/{Name}/files?rev={RevisionId}&path={Uri.EscapeDataString(path)}";
    }

    private static void Flatten(TreeNode node, int depth, List<(TreeNode Node, int Depth)> flat)
    {
        foreach (var directory in node.Directories)
        {
            flat.Add((directory, depth));
            Flatten(directory, depth + 1, flat);
        }

        foreach (var file in node.Files)
            flat.Add((file, depth));
    }

    private sealed class TreeNode(string name = "", string path = "", bool isDir = true, long size = 0)
    {
        public string Name { get; } = name;
        public string Path { get; } = path;
        public bool IsDir { get; } = isDir;
        public long Size { get; } = size;

        public List<TreeNode> Directories { get; } = [];
        public List<TreeNode> Files { get; } = [];

        private readonly Dictionary<string, TreeNode> _directoriesByName = new(StringComparer.Ordinal);

        public TreeNode GetOrAddDirectory(string directoryName, string directoryPath)
        {
            if (_directoriesByName.TryGetValue(directoryName, out var existing))
                return existing;

            var node = new TreeNode(directoryName, directoryPath, true, 0);
            _directoriesByName[directoryName] = node;
            Directories.Add(node);
            return node;
        }
    }
}
