{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.OtlpMetricExporter": "Warning"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "Atoll": {
    "DataSource": {
      "DataFileUrl": "https://aur.archlinux.org/packages-meta-ext-v1.json.gz",
      "RefreshIntervalMinutes": 10
    },
    "Mongo": {
      "ConnectionString": "mongodb://admin:change_me@localhost:27017/atoll?authSource=admin",
      "Database": "atoll",
      "Collections": {
        "Packages": "packages",
        "PackageRevisions": "package-revisions",
        "AurMetadata": "aur-metadata"
      },
      "MaxRevisions": 10,
      "MaxFileBytes": 5242880
    },
    "Git": {
      "RepositoriesPath": "./data/repos"
    },
    "Seed": {
      "Mode": "Bulk",
      "Direct": {
        "SeedDelayMs": 1000
      },
      "Bulk": {
        "MirrorUrl": "https://github.com/archlinux/aur",
        "CachePath": "./data/aur-mirror",
        "BatchSize": 1000,
        "BatchDelayMs": 1000,
        "Parallelism": 4,
        "AurFallbackForNotOnMirror": false
      }
    },
    "Security": {
      "Enabled": true,
      "ScannerConcurrency": 4,
      "PollIntervalMs": 100
    },
    "Refresh": {
      "Enabled": true,
      "BatchSize": 1000,
      "BatchDelayMs": 1000,
      "Parallelism": 4,
      "MaxPackagesPerRun": 10000,
      "MaxStalenessHours": 24,
      "MirrorUrl": "https://github.com/archlinux/aur",
      "CachePath": "./data/aur-mirror"
    }
  }
}
