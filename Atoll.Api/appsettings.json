{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Atoll": {
    "DataSource": {
      "DataFileUrl": "https://aur.archlinux.org/packages-meta-ext-v1.json.gz",
      "RefreshIntervalMinutes": 10
    },
    "Mongo": {
      "ConnectionString": "mongodb://admin:change_me@localhost:27017/atoll?authSource=admin",
      "Database": "atoll",
      "Collections": {
        "Packages": "packages",
        "AurMetadata": "aur-metadata"
      },
      "MaxRevisions": 10,
      "MaxFileBytes": 5242880
    },
    "Git": {
      "RepositoriesPath": "./data/repos"
    },
    "Seed": {
      "Mode": "Bulk",
      "Direct": {
        "SeedDelayMs": 1000
      },
      "Bulk": {
        "MirrorUrl": "https://github.com/archlinux/aur",
        "CachePath": "./data/aur-mirror",
        "BatchSize": 1000,
        "BatchDelayMs": 1000,
        "AurFallbackForNotOnMirror": false
      }
    }
  }
}
