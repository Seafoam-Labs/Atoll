root = true

# Severities are split by project: `[*.cs]` reaches Atoll.Api and Atoll.Api.Tests alike, but
# most rules are clean in one column and noisy in the other, so the sections at the bottom of
# this file promote a rule only where it is actually enforced.
#
# The glob form is load-bearing. EditorConfig auto-expands a slash-free pattern (`*.cs` means
# `**/*.cs`) yet anchors a pattern holding a mid-string slash as written, so
# `[Atoll.Api/**/*.cs]` does not match the project-root files that `[Atoll.Api/**.cs]` does,
# and the override is silently skipped in both directions. Keep the `**.cs` form.
[*.cs]
# Every analyzer diagnostic defaults to suggestion (surfaced in the IDE). Promote a rule by
# name once its findings are resolved; set it to none to opt out.
dotnet_analyzer_diagnostic.severity = suggestion

# ConfigureAwait is not needed: ASP.NET Core has no synchronization context.
dotnet_diagnostic.CA2007.severity = none

# Opt-outs, each a stated decision rather than debt. CA1031: catching every exception and
# logging it is the intended posture of the background workers (seed/refresh/scan loops must
# survive one bad package); narrowing the catches would trade a logged failure for a dead loop.
# CA1062 targets library API surface; every site here is a DI-resolved internal or a
# framework-supplied argument (WebApplication, EndpointFilterInvocationContext) where null
# cannot arrive. CA1002's three sites are BSON document properties whose List<T> shape the
# MongoDB serializer and init-only construction need; they are persistence types, not API.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1062.severity = none

# --- Promoted to error: a finding breaks the build, so these lock in existing discipline
# rather than asking for new work. Each is verified clean in both projects by a forced Rebuild.

# Comparison/globalization (names and keys use StringComparer.Ordinal by design;
# culture-sensitive ToString/Parse/Format pass CultureInfo.InvariantCulture). The string
# family (MA0001, MA0002, MA0006, MA0127 and the overlapping CA1307, which ships disabled
# and is turned on by its entry) pins the comparison or comparer at every call site, so the
# intent stays explicit in the code that gates untrusted content.
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
dotnet_diagnostic.CA1862.severity = error
dotnet_diagnostic.MA0001.severity = error
dotnet_diagnostic.MA0002.severity = error
dotnet_diagnostic.MA0006.severity = error
dotnet_diagnostic.MA0074.severity = error
dotnet_diagnostic.MA0127.severity = error

# Async/cancellation, including the fire-and-forget check VSTHRD110. MA0040 forwards the caller's
# token (tests use Xunit.TestContext.Current.CancellationToken); VSTHRD103 keeps the async overload
# inside async methods and has one per-file exemption at the bottom of this file; MA0042 disposes
# asynchronously wherever the type offers it.
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.MA0040.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error

# Collections/LINQ hygiene and logging message templates. An indexable collection answers through
# its indexer or length, and Order replaces an OrderBy whose key is the element itself.
dotnet_diagnostic.CA1826.severity = error
dotnet_diagnostic.CA1829.severity = error
dotnet_diagnostic.CA1841.severity = error
dotnet_diagnostic.CA1860.severity = error
dotnet_diagnostic.CA2254.severity = error
dotnet_diagnostic.MA0159.severity = error

# Ownership of disposables: a class that owns one either seals itself or offers a virtual dispose
# core, an IHttpClientFactory double hands out a single client, and a created disposable is
# either disposed or passed on (IDISP001/IDISP004; the test project opts out below because its
# findings are fixture lifetimes owned by the test host).
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.IDISP001.severity = error
dotnet_diagnostic.IDISP004.severity = error
dotnet_diagnostic.IDISP014.severity = error
dotnet_diagnostic.IDISP025.severity = error
dotnet_diagnostic.IDISP026.severity = error

# Redundant constructs that the declaration or the API signature already expresses: a member that
# touches no instance data, an interpolation hole with nothing in it.
dotnet_diagnostic.CA1805.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA2263.severity = error
dotnet_diagnostic.MA0089.severity = error
dotnet_diagnostic.MA0160.severity = error
dotnet_diagnostic.MA0184.severity = error
dotnet_diagnostic.MA0194.severity = error

# Allocation-avoiding overloads the framework already offers: Contains for a containment
# test, the char and Span forms instead of a Substring or single-char string, TryGetValue
# instead of ContainsKey plus indexing, Convert.ToHexString over BitConverter.ToString,
# ordinal comparison, and named placeholders in log templates.
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1846.severity = error
dotnet_diagnostic.CA1847.severity = error
dotnet_diagnostic.CA1854.severity = error
dotnet_diagnostic.CA1865.severity = error
dotnet_diagnostic.CA1867.severity = error
dotnet_diagnostic.CA1872.severity = error
dotnet_diagnostic.CA2249.severity = error
dotnet_diagnostic.CA2253.severity = error

# Type and member shape: ignored return values, types declared outside namespaces, unused
# private fields, never-instantiated internal types, settable collection properties, thrown
# reserved exception types, and parameterless Get-methods that should be properties.
dotnet_diagnostic.CA1024.severity = error
dotnet_diagnostic.CA1050.severity = error
dotnet_diagnostic.CA1806.severity = error
dotnet_diagnostic.CA1812.severity = error
dotnet_diagnostic.CA1823.severity = error
dotnet_diagnostic.CA2201.severity = error
dotnet_diagnostic.CA2227.severity = error

# Regression guards for a service that scans untrusted AUR content: weak and broken crypto
# must never appear, and a constant format string gets a pre-parsed CompositeFormat.
# CA3075 is deliberately absent: its analyzer (Microsoft.NetFramework.Analyzers) skips any
# compilation whose System.String does not come from mscorlib, so it can never report on a
# net10.0 target, and an error entry would enforce nothing.
dotnet_diagnostic.CA1863.severity = error
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error

# --- Left at suggestion on purpose: active and useful, but high-count, so they would flood
# rather than guide. Count a rule's findings with a forced Rebuild; an incremental build
# reports a false clean and every warning prints twice in the log.
# The global default above only reaches rules that ship enabled by default: CA2000 and CA1063
# are invisible here and need their own dotnet_diagnostic entry to run at all.
# A rule that is clean in one project and noisy in the other belongs in the scoped sections
# below, not here.

# --- Production scope: promote a rule as soon as its Atoll.Api column is clean, even while
# the test project still carries findings for it.
[Atoll.Api/**.cs]
# These four stay here because their test findings are the rule's premise not holding, not debt.
# CA1861 assumes a method that is called repeatedly, while an assertion runs once and its array is
# the expected literal. MA0136 would ban every multi-line raw string, which is how the PKGBUILD and
# dump fixtures are written. VSTHRD002's two remaining sites are a static skip predicate and a
# synchronous test constructor, neither of which can await. IDISP007's is the assembly Mongo fixture
# disposing the container it started itself, held statically so tests can probe availability.
dotnet_diagnostic.CA1861.severity = error
dotnet_diagnostic.IDISP007.severity = error
dotnet_diagnostic.MA0136.severity = error
dotnet_diagnostic.VSTHRD002.severity = error
# MA0076 (interpolation holes take no format provider, so the value needs an explicit
# ToString(..., CultureInfo.InvariantCulture)) is production-clean; its 58 test findings are
# assertion messages and fixture text with no culture-sensitive output contract.
dotnet_diagnostic.MA0076.severity = error

# --- Per-file exemption: the last matching section wins, so this must stay below the `[*.cs]`
# promotion. The parameterless Aggregate() only builds a pipeline and cannot block; the
# AggregateAsync VSTHRD103 compares it to takes a rendered pipeline, which the fluent stages here
# cannot express.
[Atoll.Api/Services/Security/Persistence/MongoPackageSecurityRepository.cs]
dotnet_diagnostic.VSTHRD103.severity = suggestion

# --- Test scope: conventions that are a deliberate choice only inside tests.
[Atoll.Api.Tests/**.cs]
# Assertion style: consume the value an assertion already returns (Assert.Single, the
# IsType result) instead of re-deriving it, prefer the IsType/IsNotType naming with an
# explicit exactMatch flag over IsAssignableFrom, and use equality assertions rather than
# Assert.True(a == b).
dotnet_diagnostic.xUnit2024.severity = error
dotnet_diagnostic.xUnit2032.severity = error
dotnet_diagnostic.xUnit2033.severity = error
# Fixture lifetimes: disposable test infrastructure (WebApplicationFactory hosts, Mongo
# containers, streams handed to the code under test) is owned by the test host or asserted on
# after the fact, not disposed at each creation site, so the repo-wide IDISP001/IDISP004
# promotion does not apply here.
dotnet_diagnostic.IDISP001.severity = none
dotnet_diagnostic.IDISP004.severity = none
