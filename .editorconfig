root = true

# Severities are split by project: `[*.cs]` reaches Atoll.Api and Atoll.Api.Tests alike, but
# most rules are clean in one column and noisy in the other, so the sections at the bottom of
# this file promote a rule only where it is actually enforced.
#
# The glob form is load-bearing. EditorConfig auto-expands a slash-free pattern (`*.cs` means
# `**/*.cs`) yet anchors a pattern holding a mid-string slash as written, so
# `[Atoll.Api/**/*.cs]` does not match the project-root files that `[Atoll.Api/**.cs]` does,
# and the override is silently skipped in both directions. Keep the `**.cs` form.
[*.cs]
# Every analyzer diagnostic defaults to suggestion (surfaced in the IDE). Promote a rule by
# name once its findings are resolved; set it to none to opt out.
dotnet_analyzer_diagnostic.severity = suggestion

# ConfigureAwait is not needed: ASP.NET Core has no synchronization context.
dotnet_diagnostic.CA2007.severity = none

# --- Promoted to error: a finding breaks the build, so these lock in existing discipline
# rather than asking for new work. Each is verified clean in both projects by a forced Rebuild.

# Comparison/globalization (names and keys use StringComparer.Ordinal by design;
# culture-sensitive ToString/Parse/Format pass CultureInfo.InvariantCulture).
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
dotnet_diagnostic.CA1862.severity = error

# Async/cancellation, including the fire-and-forget check VSTHRD110. MA0040 forwards the caller's
# token (tests use Xunit.TestContext.Current.CancellationToken); VSTHRD103 keeps the async overload
# inside async methods and has one per-file exemption at the bottom of this file.
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.MA0040.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error

# Collections/LINQ hygiene and logging message templates.
dotnet_diagnostic.CA1841.severity = error
dotnet_diagnostic.CA1860.severity = error
dotnet_diagnostic.CA2254.severity = error

# Redundant constructs that the declaration or the API signature already expresses.
dotnet_diagnostic.CA1805.severity = error
dotnet_diagnostic.CA2263.severity = error
dotnet_diagnostic.MA0089.severity = error
dotnet_diagnostic.MA0160.severity = error
dotnet_diagnostic.MA0194.severity = error

# --- Left at suggestion on purpose: active and useful, but high-count, so they would flood
# rather than guide. Count a rule's findings with a forced Rebuild; an incremental build
# reports a false clean and every warning prints twice in the log.
# IDISP001, MA0002.
# The global default above only reaches rules that ship enabled by default: CA2000, CA1063,
# CA1307, CA1031, CA1062 and CA1002 are invisible here and need their own dotnet_diagnostic
# entry to run at all.
# A rule that is clean in one project and noisy in the other belongs in the scoped sections
# below, not here.

# --- Production scope: promote a rule as soon as its Atoll.Api column is clean, even while
# the test project still carries findings for it.
[Atoll.Api/**.cs]
# Step 2: zero findings in production, test fixtures only, so a violation breaks the app
# build while the test project keeps its own column.
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA1826.severity = error
dotnet_diagnostic.CA1829.severity = error
dotnet_diagnostic.CA1861.severity = error
dotnet_diagnostic.IDISP007.severity = error
dotnet_diagnostic.IDISP014.severity = error
dotnet_diagnostic.IDISP025.severity = error
dotnet_diagnostic.IDISP026.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.MA0074.severity = error
dotnet_diagnostic.MA0136.severity = error
dotnet_diagnostic.MA0159.severity = error
dotnet_diagnostic.MA0184.severity = error
dotnet_diagnostic.VSTHRD002.severity = error

# --- Per-file exemption: the last matching section wins, so this must stay below the `[*.cs]`
# promotion. The parameterless Aggregate() only builds a pipeline and cannot block; the
# AggregateAsync VSTHRD103 compares it to takes a rendered pipeline, which the fluent stages here
# cannot express.
[Atoll.Api/Services/Security/Persistence/MongoPackageSecurityRepository.cs]
dotnet_diagnostic.VSTHRD103.severity = suggestion

# --- Test scope: conventions that are a deliberate choice only inside tests.
[Atoll.Api.Tests/**.cs]
